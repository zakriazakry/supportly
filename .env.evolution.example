# Evolution API Configuration
# ============================

# Required: Your Evolution API credentials
EVOLUTION_API_KEY=your-global-api-key-here
EVOLUTION_BASE_URL=https://your-evolution-api-url.com

# Default integration type (WHATSAPP-BAILEYS or WHATSAPP-BUSINESS)
EVOLUTION_DEFAULT_INTEGRATION=WHATSAPP-BAILEYS

# Webhook Configuration
# ----------------------
EVOLUTION_WEBHOOK_ENABLED=true
EVOLUTION_WEBHOOK_URL="${APP_URL}/api/evolution/webhook"
EVOLUTION_WEBHOOK_BY_EVENTS=false
EVOLUTION_WEBHOOK_BASE64=true

# Instance Settings
# -----------------
EVOLUTION_REJECT_CALL=true
EVOLUTION_MSG_CALL="عذراً، لا أقبل المكالمات"
EVOLUTION_GROUPS_IGNORE=false
EVOLUTION_ALWAYS_ONLINE=true
EVOLUTION_READ_MESSAGES=false
EVOLUTION_READ_STATUS=false
EVOLUTION_SYNC_FULL_HISTORY=false

# Message Delays (in milliseconds)
# ---------------------------------
EVOLUTION_DELAY_BETWEEN_MESSAGES=1200
EVOLUTION_DELAY_TYPING=2000

# Proxy Configuration (Optional)
# -------------------------------
EVOLUTION_PROXY_ENABLED=false
EVOLUTION_PROXY_HOST=
EVOLUTION_PROXY_PORT=
EVOLUTION_PROXY_PROTOCOL=http
EVOLUTION_PROXY_USERNAME=
EVOLUTION_PROXY_PASSWORD=

# Chatwoot Integration (Optional)
# --------------------------------
EVOLUTION_CHATWOOT_ENABLED=false
EVOLUTION_CHATWOOT_ACCOUNT_ID=
EVOLUTION_CHATWOOT_TOKEN=
EVOLUTION_CHATWOOT_URL=
EVOLUTION_CHATWOOT_SIGN_MSG=true
EVOLUTION_CHATWOOT_REOPEN_CONVERSATION=true
EVOLUTION_CHATWOOT_CONVERSATION_PENDING=false
EVOLUTION_CHATWOOT_IMPORT_CONTACTS=true
EVOLUTION_CHATWOOT_NAME_INBOX=WhatsApp
EVOLUTION_CHATWOOT_MERGE_BRAZIL_CONTACTS=false
EVOLUTION_CHATWOOT_IMPORT_MESSAGES=true
EVOLUTION_CHATWOOT_DAYS_LIMIT_IMPORT_MESSAGES=3

# RabbitMQ Integration (Optional)
# --------------------------------
EVOLUTION_RABBITMQ_ENABLED=false

# AWS SQS Integration (Optional)
# -------------------------------
EVOLUTION_SQS_ENABLED=false

# Typebot Integration (Optional)
# -------------------------------
EVOLUTION_TYPEBOT_ENABLED=false
EVOLUTION_TYPEBOT_URL=
EVOLUTION_TYPEBOT_ID=

# Logging Configuration
# ----------------------
EVOLUTION_LOGGING_ENABLED=true
EVOLUTION_LOG_CHANNEL=daily
EVOLUTION_LOG_LEVEL=info

# Rate Limiting
# -------------
EVOLUTION_RATE_LIMITING_ENABLED=true
EVOLUTION_MAX_REQUESTS_PER_MINUTE=60
EVOLUTION_MAX_MESSAGES_PER_MINUTE=30

# Auto-Retry Configuration
# ------------------------
EVOLUTION_RETRY_ENABLED=true
EVOLUTION_RETRY_MAX_ATTEMPTS=3
EVOLUTION_RETRY_DELAY_MS=1000
