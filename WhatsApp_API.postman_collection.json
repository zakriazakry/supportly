                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"number\": \"218912345678\",\n    \"media_type\": \"video\",\n    \"media_url\": \"https://example.com/video.mp4\",\n    \"caption\": \"فيديو رائع 🎥\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}/messages/media",
