                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"number\": \"218912345678\",\n    \"title\": \"اختر خياراً\",\n    \"description\": \"هل تريد المتابعة؟\",\n    \"buttons\": [\n        {\n            \"text\": \"نعم ✅\",\n            \"id\": \"yes\"\n        },\n        {\n            \"text\": \"لا ❌\",\n            \"id\": \"no\"\n        },\n        {\n            \"text\": \"ربما 🤔\",\n            \"id\": \"maybe\"\n        }\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}/messages/buttons",
                            "host": ["{{base_url}}"],
                            "path": [
                                "whatsapp",
                                "instances",
                                "{{instance_name}}",
                                "messages",
                                "buttons"
                            ]
                        }
                    }
                },
                {
                    "name": "Send List",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"number\": \"218912345678\",\n    \"title\": \"القائمة الرئيسية\",\n    \"description\": \"اختر قسماً من القائمة\",\n    \"button_text\": \"عرض الخيارات\",\n    \"sections\": [\n        {\n            \"title\": \"الخدمات\",\n            \"rows\": [\n                {\n                    \"title\": \"خدمة 1\",\n                    \"description\": \"وصف الخدمة الأولى\",\n                    \"rowId\": \"service_1\"\n                },\n                {\n                    \"title\": \"خدمة 2\",\n                    \"description\": \"وصف الخدمة الثانية\",\n                    \"rowId\": \"service_2\"\n                }\n            ]\n        },\n        {\n            \"title\": \"الدعم\",\n            \"rows\": [\n                {\n                    \"title\": \"تواصل معنا\",\n                    \"description\": \"للتواصل مع فريق الدعم\",\n                    \"rowId\": \"contact_support\"\n                }\n            ]\n        }\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}/messages/list",
                            "host": ["{{base_url}}"],
                            "path": [
                                "whatsapp",
                                "instances",
                                "{{instance_name}}",
                                "messages",
                                "list"
                            ]
                        }
                    }
                },
                {
                    "name": "Mark as Read",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"messages\": [\n        {\n            \"remoteJid\": \"218912345678@s.whatsapp.net\",\n            \"fromMe\": false,\n            \"id\": \"MESSAGE_ID_HERE\"\n        }\n    ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}/messages/mark-read",
                            "host": ["{{base_url}}"],
                            "path": [
                                "whatsapp",
                                "instances",
                                "{{instance_name}}",
                                "messages",
                                "mark-read"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Messages",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}/messages?remote_jid=218912345678@s.whatsapp.net",
                            "host": ["{{base_url}}"],
                            "path": [
                                "whatsapp",
                                "instances",
                                "{{instance_name}}",
                                "messages"
                            ],
                            "query": [
                                {
                                    "key": "remote_jid",
                                    "value": "218912345678@s.whatsapp.net"
                                }
                            ]
                        }
                    }
                }
            ]
        },
