                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"number\": \"218912345678\",\n    \"text\": \"مرحباً! هذه رسالة تجريبية من البوت 🎉\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}/messages/text",
                            "host": ["{{base_url}}"],
                            "path": [
                                "whatsapp",
                                "instances",
                                "{{instance_name}}",
                                "messages",
                                "text"
                            ]
                        }
                    }
