{
    "info": {
        "name": "WhatsApp API - Supportly",
        "description": "مجموعة كاملة من API endpoints لنظام WhatsApp",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000/api",
            "type": "string"
        },
        {
            "key": "auth_token",
            "value": "YOUR_AUTH_TOKEN_HERE",
            "type": "string"
        },
        {
            "key": "instance_name",
            "value": "my_whatsapp_bot",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Instance Management",
            "item": [
                {
                    "name": "Create Instance",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"instance_name\": \"{{instance_name}}\",\n    \"integration\": \"WHATSAPP-BAILEYS\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances",
                            "host": ["{{base_url}}"],
                            "path": ["whatsapp", "instances"]
                        }
                    }
                },
                {
                    "name": "Get QR Code",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}/qrcode",
                            "host": ["{{base_url}}"],
                            "path": [
                                "whatsapp",
                                "instances",
                                "{{instance_name}}",
                                "qrcode"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Connection Status",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}/status",
                            "host": ["{{base_url}}"],
                            "path": [
                                "whatsapp",
                                "instances",
                                "{{instance_name}}",
                                "status"
                            ]
                        }
                    }
                },
                {
                    "name": "Logout Instance",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}/logout",
                            "host": ["{{base_url}}"],
                            "path": [
                                "whatsapp",
                                "instances",
                                "{{instance_name}}",
                                "logout"
                            ]
                        }
                    }
                },
                {
                    "name": "Delete Instance",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{auth_token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}",
                            "host": ["{{base_url}}"],
                            "path": [
                                "whatsapp",
                                "instances",
                                "{{instance_name}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Messages",
            "item": [
                {
                    "name": "Send Text Message",
                    "request": {
                        "method": "POST",
                        "header": [
