                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"number\": \"218912345678\",\n    \"media_type\": \"document\",\n    \"media_url\": \"https://example.com/document.pdf\",\n    \"file_name\": \"العقد.pdf\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/whatsapp/instances/{{instance_name}}/messages/media",
